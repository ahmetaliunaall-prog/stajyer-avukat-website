{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "stajyer-avukat-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/*",
      "/",
      "/api/*",
      "/admin",
      "/admin/*",
      "/robots.txt",
      "/sitemap.xml",
      "/makaleler",
      "/ictihatlar",
      "/sozluk",
      "/sss",
      "/hakkimda",
      "/iletisim",
      "/arama",
      "/makale/*",
      "/ictihat/*",
      "/sozluk/*"
    ]
  },
  "vars": {
    "SUPABASE_URL": "https://ztkopywelwximjiopdci.supabase.co"
  }
}

