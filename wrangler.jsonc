{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "stajyer-avukat-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/",
      "/api/*",
      "/index.html",
      "/app.js",
      "/styles.css",
      "/favicon.svg",
      "/404.html",
      "/admin",
      "/admin/*",
      "/robots.txt",
      "/sitemap.xml",
      "/makaleler",
      "/ictihatlar",
      "/sozluk",
      "/sss",
      "/hakkimda",
      "/iletisim",
      "/arama",
      "/makale/*",
      "/ictihat/*",
      "/sozluk/*"
    ]
  },
  "vars": {
    "SUPABASE_URL": "https://ztkopywelwximjiopdci.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_mkA2Q3ivb3uhxSb9QxF6cg_MxcfZGJ-"
  }
}

